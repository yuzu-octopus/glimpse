{
	"name": "glimpse",
	"private": true,
	"version": "0.4.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:server": "bun --watch src/server/index.ts",
		"build": "bun check && vite build",
		"preview": "vite preview",
		"start": "bun run src/server/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"check-config": "bun scripts/check-config.ts",
		"new-widget": "bun scripts/new-widget.ts",
		"typecheck": "bun check",
		"lint": "biome lint",
		"fmt": "bun fmt '**/*.{ts,tsx,mjs,js,jsx,json,css}'",
		"fmt:check": "bun fmt --check '**/*.{ts,tsx,mjs,js,jsx,json,css}'"
	},
	"dependencies": {
		"@astryxdesign/core": "^0.7.13",
		"astryx-dracula": "^0.8.0",
		"jsonpath-plus": "^11.3.0",
		"lucide-react": "^1.72.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.5",
		"systeminformation": "^5.33.19",
		"vite-plugin-pwa": "^2.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@astryxdesign/cli": "^0.7.13",
		"@biomejs/biome": "2.6.6",
		"@stylexjs/stylex": "^0.19.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.9",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"jsdom": "^31.0.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"trustedDependencies": [
		"@astryxdesign/cli",
		"@astryxdesign/core"
	],
	"license": "MIT"
}
